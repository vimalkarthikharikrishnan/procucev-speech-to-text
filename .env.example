# Copy to .env and fill in. Never commit .env.
PORT=3000
DATABASE_URL=postgres://procucev:procucev_local@localhost:5433/procucev

# Which speech-to-text engine the server uses: gemini | whisper
SPEECH_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-live
# Used only when SPEECH_PROVIDER=whisper (self-hosted open-source service)
WHISPER_URL=ws://localhost:9000
